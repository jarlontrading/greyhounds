{
  "RacingTrader": {
    "Url": "http://127.0.0.1:5287",
    "DisableHostedWorkers": true,
    "EnableBetfredWorker": true,
    "SkipStartupSchema": true,
    "RunStartupCleanup": false,
    "PublishTargets": "DEMO"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "BetAhoy": {
    "Enabled": true,
    "UseOff": true,
    "UseFallbackPrices": true
  }
}
