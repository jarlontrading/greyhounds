{
  "RacingTrader": {
    "Url": "http://127.0.0.1:5287",
    "DisableHostedWorkers": true,
    "EnableBetfredWorker": true,
    "SkipStartupSchema": true,
    "RunStartupCleanup": false,
    "PublishTargets": "DEMO",
    "PlacePricing": {
      "Greyhounds": {
        "Model": "DiscountedHarville",
        "SecondExponent": 0.81,
        "ThirdExponent": 0.65,
        "FourthExponent": 0.52
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "BetAhoy": {
    "Enabled": true,
    "UseOff": true,
    "UseFallbackPrices": true
  }
}
